# Copy to .env and fill in. `.env` is gitignored — never commit it.
#
#   cp .env.example .env

# =============================================================================
# HOST — the single most important value in this file
# =============================================================================
# The Elastic IP of your EC2 instance. NOT localhost, NOT a private IP,
# NOT a hostname.
#
# Every entity ID, ACS URL, redirect URI and metadata document on BOTH sides
# is built from this. If it changes, every connection breaks at once and the
# symptoms look like config corruption rather than an address change.
#
# This is why the runbook insists on an Elastic IP: a stop/start of the
# instance changes the public IP and takes the whole lab down with it.
HOST_IP=203.0.113.10

# =============================================================================
# Image versions
# =============================================================================
# Matches the version pinned in the BYOI platform repo Dockerfile (PF_VERSION),
# so what you learn here transfers directly. BYOI pulls the Iron Bank build;
# this lab uses the public Ping DevOps image of the same version.
PF_VERSION=13.0.2-latest

KEYCLOAK_VERSION=26.0
GRAFANA_VERSION=11.3.0

# =============================================================================
# PingFederate DevOps licence
# =============================================================================
# From https://devops.pingidentity.com/ — free community developer programme.
#
# WARNING: these keys expire. Yours is due around 27 Aug 2026. Renew BEFORE
# starting Phase 4, not during it.
PING_IDENTITY_DEVOPS_USER=you@example.com
PING_IDENTITY_DEVOPS_KEY=00000000-0000-0000-0000-000000000000

# Admin console password. Only read on FIRST boot — after that the account
# lives in the pf-data volume and changing this here does nothing.
# Must satisfy PingFederate's complexity rules.
PF_ADMIN_PASSWORD=Lab-PF-Admin-2026!

# =============================================================================
# Keycloak (upstream IdP)
# =============================================================================
KEYCLOAK_ADMIN_PASSWORD=Lab-KC-Admin-2026!

# =============================================================================
# Flask SAML SP (downstream SAML app)
# =============================================================================
# Stable key so sessions survive container restarts. Any long random string.
FLASK_SECRET_KEY=change-me-to-something-random-and-long

# --- Filled in during PHASE 2, after the PF SP Connection exists ---
# Leave blank until then. The app starts and serves /metadata regardless;
# it just cannot verify an assertion until these are set.
#
# IDP_ENTITY_ID  = PingFederate's SAML entity ID (Server Settings)
# IDP_SSO_URL    = https://<HOST_IP>:9031/idp/SSO.saml2
# IDP_X509_CERT  = PF's signing cert, base64, ONE line, no BEGIN/END markers
IDP_ENTITY_ID=
IDP_SSO_URL=
IDP_X509_CERT=

# =============================================================================
# Grafana (downstream OIDC app)
# =============================================================================
GRAFANA_ADMIN_PASSWORD=Lab-GF-Admin-2026!

# --- Filled in during PHASE 5, after the PF OAuth client exists ---
# Flip OIDC_ENABLED to true only once the client is registered in PF.
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
