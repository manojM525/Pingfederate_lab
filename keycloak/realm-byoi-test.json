  "clientScopes": [
    {
      "name": "byoi-attributes",
      "description": "Groups and department, for PingFederate to consume",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "department",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "department",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "preferred_username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "pingfederate-broker",
      "name": "PingFederate Broker (OIDC)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "pf-lab-client-secret-2026",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://HOST_IP_PLACEHOLDER:9031/sp/eyJwaWQiOiJ*",
        "https://HOST_IP_PLACEHOLDER:9031/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "byoi-attributes"
      ]
    },
    {
      "clientId": "PF_SAML_ENTITY_ID_PLACEHOLDER",
      "name": "PingFederate Broker (SAML)",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": true,
      "redirectUris": [
        "https://HOST_IP_PLACEHOLDER:9031/sp/ACS.saml2"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.client.signature": "false",
        "saml_name_id_format": "username",
        "saml_force_name_id_format": "true",
        "saml.authnstatement": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "friendly.name": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "firstName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "firstName",
            "friendly.name": "firstName",
            "attribute.name": "firstName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "lastName",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "lastName",
            "friendly.name": "lastName",
            "attribute.name": "lastName",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "department",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "friendly.name": "department",
            "attribute.name": "department",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "config": {
            "full.path": "false",
            "single": "true",
            "attribute.name": "groups",
            "attribute.nameformat": "Basic"
          }
        }
      ]
    }
  ]
}